# ============================================================================
# DLC Manager — configuration serveur
# Copier ce fichier en `.env` et remplir les valeurs avant de démarrer en prod.
# Le fichier `.env` est ignoré par git (voir .gitignore racine).
# ============================================================================

# Mode d'exécution: development | production
# En 'production', le serveur refuse de démarrer si JWT_SECRET n'est pas défini.
NODE_ENV=production

# Port et host d'écoute HTTP
PORT=3000
HOST=0.0.0.0

# ----------------------------------------------------------------------------
# SÉCURITÉ — OBLIGATOIRE en production
# ----------------------------------------------------------------------------
# Secret pour signer les JWT. Générer avec: openssl rand -hex 64
JWT_SECRET=

# Origines autorisées par CORS (séparées par des virgules).
# Laisser vide = '*' (tout autoriser, déconseillé en prod).
# Exemple: https://dlc.exemple.fr,https://admin.exemple.fr
CORS_ORIGINS=

# ----------------------------------------------------------------------------
# Stockage (chemins absolus recommandés en prod)
# ----------------------------------------------------------------------------
# Fichier SQLite. Par défaut: <server>/dlc-manager.db
# DB_PATH=/var/lib/dlc-manager/dlc-manager.db

# Dossier des photos uploadées. Par défaut: <server>/uploads
# UPLOADS_DIR=/var/lib/dlc-manager/uploads

# ----------------------------------------------------------------------------
# Utilisateur initial (créé UNIQUEMENT au premier démarrage si la table users
# ne contient pas déjà un user avec ce login)
# ----------------------------------------------------------------------------
SEED_USER_LOGIN=Honfleur
SEED_USER_PASSWORD=changeme

# Optionnel — code Anabel et identifiants Pricer (OAuth IAM Pricer)
SEED_USER_CODE_ANABEL=
SEED_USER_PRICER_ID=
SEED_USER_PRICER_PASSWORD=
