{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "android": {
        "buildType": "apk",
        "channel": "preview"
      },
      "ios": {
        "simulator": false,
        "distribution": "internal",
        "channel": "preview"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "channel": "production"
      },
      "ios": {
        "distribution": "store",
        "channel": "production"
      }
    }
  }
}
